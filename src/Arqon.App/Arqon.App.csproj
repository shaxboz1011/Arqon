<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Windows Forms is only used for the tray icon (NotifyIcon); keep its names out of the WPF code. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\arqon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Remove="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\arqon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Arqon.Core\Arqon.Core.csproj" />
  </ItemGroup>
</Project>
