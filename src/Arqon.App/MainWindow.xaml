<Window x:Class="Arqon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Arqon.App.ViewModels"
        xmlns:v="clr-namespace:Arqon.App.Views"
        Title="Arqon" Icon="pack://application:,,,/Resources/arqon.ico" Width="1180" Height="760" MinWidth="980" MinHeight="620"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <DataTemplate DataType="{x:Type vm:PanelViewModel}"><v:PanelView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AppsViewModel}"><v:AppsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DownloadsViewModel}"><v:DownloadsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsageViewModel}"><v:UsageView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Background="{StaticResource SidebarBrush}">
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="A" FontWeight="Bold" FontSize="12" Foreground="#0B0E14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ARQON" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="10,1,0,0" FontSize="12" Text="{Binding LinkSummary}" />
                    <Border Style="{StaticResource Pill}" Background="#26304A" Margin="12,0,0,0" Visibility="{Binding Demo, Converter={StaticResource B2V}}">
                        <TextBlock Text="DEMO" FontSize="10" FontWeight="SemiBold" Foreground="#9FB4FF" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="OnMinimize" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="OnMaximize" />
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE8BB;" Click="OnClose" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,0" Padding="10,14">
                    <Grid>
                        <StackPanel>
                            <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsPanel, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" CommandParameter="panel">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE80F;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" />
                                    <TextBlock Text="{DynamicResource S.Nav.Panel}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsApps, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" CommandParameter="apps">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" />
                                    <TextBlock Text="{DynamicResource S.Nav.Apps}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsDownloads, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" CommandParameter="downloads">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" />
                                    <TextBlock Text="{DynamicResource S.Nav.Downloads}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsUsage, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" CommandParameter="usage">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9D2;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" />
                                    <TextBlock Text="{DynamicResource S.Nav.Usage}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Style="{StaticResource NavButton}" IsChecked="{Binding IsSettings, Mode=OneWay}"
                                         Command="{Binding NavigateCommand}" CommandParameter="settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="26" />
                                    <TextBlock Text="{DynamicResource S.Nav.Settings}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <TextBlock VerticalAlignment="Bottom" Style="{StaticResource MutedText}" FontSize="11" Margin="12,0,0,2" Text="Arqon 0.1 · MIT" />
                    </Grid>
                </Border>

                <!-- Page -->
                <ContentControl Grid.Column="1" Content="{Binding Current}" Margin="28,22,18,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
