<UserControl x:Class="Arqon.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Nav.Settings}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,16" Text="{DynamicResource S.Set.Sub}" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.GameProtection}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.GameProtectionBody}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding GameProtection, Mode=TwoWay}" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.SystemMode}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.SystemModeBody}" />
                        <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding SystemModeNote}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="#4ADE80" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SystemModeProblem}" Value="True">
                                            <Setter Property="Foreground" Value="#F59E0B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SystemMode, Mode=TwoWay}"
                                  IsEnabled="{Binding SystemModeAvailable}" Margin="16,0,0,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" Visibility="{Binding ShowSetup, Converter={StaticResource B2V}}">
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,8" Text="{DynamicResource S.Setup.Body}" />
                        <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Padding="14,7" Content="{DynamicResource S.Setup.Button}"
                                Command="{Binding SetUpCommand}" IsEnabled="{Binding SetupIdle}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" Visibility="{Binding HasSetupStatus, Converter={StaticResource B2V}}">
                        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding SetupPercent, Mode=OneWay}" Margin="0,0,0,6"
                                     Visibility="{Binding SettingUp, Converter={StaticResource B2V}}" />
                        <TextBlock FontSize="12" Foreground="#9FB4FF" TextWrapping="Wrap" Text="{Binding SetupStatus}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.SafeGame}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.SafeGameBody}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SafeGameMode, Mode=TwoWay}" Margin="16,0,0,0" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.FixTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Fix.Body}" />
                        <TextBlock FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding FixStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Foreground" Value="#4ADE80" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NeedsFix}" Value="True">
                                            <Setter Property="Foreground" Value="#F59E0B" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{DynamicResource S.Fix.Button}" Command="{Binding FixCommand}"
                            Margin="16,0,0,0" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Language}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{DynamicResource S.Set.LanguageBody}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Parallel}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.ParallelBody}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Margin="16,0,0,0" MinWidth="90" ItemsSource="{Binding ParallelOptions}" SelectedItem="{Binding MaxConcurrentDownloads, Mode=TwoWay}">
                        <!-- The theme's default item template reads a Label property; plain numbers have none. -->
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Mode=OneWay}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Seed}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.SeedBody}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SeedTorrents, Mode=TwoWay}" Margin="16,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                    <Grid Margin="0,14,0,0" Visibility="{Binding SeedTorrents, Converter={StaticResource B2V}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.SeedRatio}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.SeedRatioBody}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Margin="16,0,0,0" MinWidth="90" ItemsSource="{Binding SeedRatios}" SelectedItem="{Binding SelectedSeedRatio, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Upnp}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.UpnpBody}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding TorrentPortForwarding, Mode=TwoWay}" Margin="16,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Limit}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.LimitBody}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Margin="16,0,0,0" MinWidth="90" ItemsSource="{Binding DailyLimits}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedDailyLimit, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Saver}" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.SaverBody}" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,8,0,0" Text="{DynamicResource S.Set.SaverNone}"
                               Visibility="{Binding NoLinks, Converter={StaticResource B2V}}" />
                    <ItemsControl ItemsSource="{Binding SaverLinks}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Foreground="{DynamicResource TextBrush}" Margin="0,3" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.SaveMobile}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.SaveMobileBody}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SaveMobileAtLimit, Mode=TwoWay}" Margin="16,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Schedule}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.ScheduleBody}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ScheduleEnabled, Mode=TwoWay}" Margin="16,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Visibility="{Binding ScheduleEnabled, Converter={StaticResource B2V}}">
                        <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center" Text="{DynamicResource S.Set.ScheduleFrom}" />
                        <ComboBox Margin="8,0,0,0" MinWidth="80" ItemsSource="{Binding Hours}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedScheduleStart, Mode=TwoWay}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="14,0,0,0" VerticalAlignment="Center" Text="{DynamicResource S.Set.ScheduleTo}" />
                        <ComboBox Margin="8,0,0,0" MinWidth="80" ItemsSource="{Binding Hours}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedScheduleEnd, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Updates}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.UpdatesBody}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding CheckUpdates, Mode=TwoWay}" Margin="16,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                    <TextBlock FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Text="{Binding UpdateStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Setter Property="Foreground" Value="#8B93A7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                        <Setter Property="Foreground" Value="#4ADE80" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource GhostButton}" Padding="12,6" Content="{DynamicResource S.Upd.Check}" Command="{Binding CheckNowCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="8,0,0,0" Content="{Binding UpdateNowText}" Command="{Binding UpdateNowCommand}"
                                IsEnabled="{Binding UpdateIdle}" Visibility="{Binding HasUpdate, Converter={StaticResource B2V}}" />
                        <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="8,0,0,0" Content="{DynamicResource S.Upd.Page}" Command="{Binding DownloadUpdateCommand}"
                                Visibility="{Binding HasUpdate, Converter={StaticResource B2V}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Unit}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.UnitBody}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Margin="16,0,0,0" ItemsSource="{Binding SpeedUnits}" DisplayMemberPath="Label"
                              SelectedItem="{Binding SelectedSpeedUnit, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Tray}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.TrayBody}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding CloseToTray, Mode=TwoWay}" Margin="16,0,0,0" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Notifications}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.NotificationsBody}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding Notifications, Mode=TwoWay}" Margin="16,0,0,0" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Clipboard}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.ClipboardBody}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding ClipboardWatch, Mode=TwoWay}" Margin="16,0,0,0" />
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Meter}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.MeterBody}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding TaskbarMeter, Mode=TwoWay}" Margin="16,0,0,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Shell}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.ShellBody}" />
                        <TextBlock Foreground="#F59E0B" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding ShellOtherNote}"
                                   Visibility="{Binding MagnetOwnedByOther, Converter={StaticResource B2V}}" />
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,6"
                                Content="{DynamicResource S.Set.DefaultApps}" Command="{Binding OpenDefaultAppsCommand}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding OpensTorrents, Mode=TwoWay}" Margin="16,0,0,0" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Startup}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{DynamicResource S.Set.StartupBody}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Api.Title}" />
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Api.Body}" />
                        </StackPanel>
                        <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding LocalApi, Mode=TwoWay}" Margin="16,0,0,0" VerticalAlignment="Top" />
                    </Grid>
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding LocalApi, Converter={StaticResource B2V}}">
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Text="{Binding LocalApiNote, Mode=OneWay}" />
                        <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6"
                                Content="{DynamicResource S.Api.CopyToken}" Command="{Binding CopyTokenCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Diag.Title}" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Diag.Body}" />
                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,6,0,0" Text="{Binding CrashStatus, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{StaticResource GhostButton}" Padding="12,6" Content="{DynamicResource S.Diag.Copy}" Command="{Binding CopyReportCommand}" />
                        <Button Style="{StaticResource GhostButton}" Padding="12,6" Margin="8,0,0,0" Content="{DynamicResource S.Diag.Folder}" Command="{Binding OpenLogsCommand}" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding ReportMessage, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Admin}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{Binding AdminText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{DynamicResource S.Set.RestartAdmin}" Command="{Binding RestartAsAdminCommand}"
                            Visibility="{Binding CanRestartAsAdmin, Converter={StaticResource B2V}}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="2,8,0,0">
                <Run Text="{Binding Version, Mode=OneWay}" /><Run Text="  ·  MIT  ·  " /><Run Text="{DynamicResource S.Set.Tagline}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
