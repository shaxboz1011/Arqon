<UserControl x:Class="Arqon.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Nav.Settings}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,16" Text="{DynamicResource S.Set.Sub}" />

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.GameProtection}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.GameProtectionBody}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding GameProtection, Mode=TwoWay}" Margin="16,0,0,0" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.SystemMode}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Set.SystemModeBody}" />
                        <TextBlock Foreground="#F59E0B" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding SystemModeNote}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding SystemMode, Mode=TwoWay}"
                                  IsEnabled="{Binding SystemModeAvailable}" Margin="16,0,0,0" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.FixTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{DynamicResource S.Fix.Body}" />
                        <TextBlock Foreground="#4ADE80" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding FixStatus}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{DynamicResource S.Fix.Button}" Command="{Binding FixCommand}"
                            Margin="16,0,0,0" VerticalAlignment="Top" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Language}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{DynamicResource S.Set.LanguageBody}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Startup}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{DynamicResource S.Set.StartupBody}" />
                    </StackPanel>
                    <ToggleButton Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource RowTitle}" Text="{DynamicResource S.Set.Admin}" />
                        <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Text="{Binding AdminText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="{DynamicResource S.Set.RestartAdmin}" Command="{Binding RestartAsAdminCommand}"
                            Visibility="{Binding CanRestartAsAdmin, Converter={StaticResource B2V}}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="2,8,0,0">
                <Run Text="{Binding Version, Mode=OneWay}" /><Run Text="  ·  MIT  ·  " /><Run Text="{DynamicResource S.Set.Tagline}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
