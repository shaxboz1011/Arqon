<UserControl x:Class="Arqon.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Arqon.App.ViewModels"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <DataTemplate x:Key="RuleRow" DataType="{x:Type vm:AppRuleViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="170" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="40" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#26304A" Margin="0,0,12,0">
                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="#9FB4FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding ExeName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Margin="0,0,10,0" ItemsSource="{Binding KindOptions}"
                              SelectedItem="{Binding SelectedKind, Mode=TwoWay}" />
                    <ComboBox Grid.Column="2" Margin="0,0,10,0" ItemsSource="{Binding ChoiceOptions}"
                              SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <TextBox Width="70" Text="{Binding LimitText, UpdateSourceTrigger=LostFocus}" Padding="8,6"
                                 ToolTip="{Binding LimitTip}" />
                        <TextBlock Style="{StaticResource MutedText}" Text="{Binding LimitUnit}" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11" />
                    </StackPanel>
                    <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;" Command="{Binding RemoveCommand}"
                            ToolTip="{DynamicResource S.Apps.Remove}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Nav.Apps}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,16" TextWrapping="Wrap" Text="{DynamicResource S.Apps.Sub}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="PickBtn" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Content="{DynamicResource S.Apps.AddRunning}"
                            Command="{Binding TogglePickerCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource S.Apps.Add}" Command="{Binding AddFromFileCommand}" />
                    <Popup IsOpen="{Binding PickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=PickBtn}" Placement="Bottom"
                           StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="4" Margin="0,4,0,0" MinWidth="240" MaxHeight="320">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding RunningApps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource GhostButton}" Background="Transparent" HorizontalContentAlignment="Left"
                                                    Padding="10,7" Content="{Binding}"
                                                    Command="{Binding DataContext.AddRunningCommand, ElementName=Root}" CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,14" BorderBrush="#F59E0B" Visibility="{Binding SystemModeOff, Converter={StaticResource B2V}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="#F59E0B" FontSize="18" Margin="0,0,12,0" />
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="780" Text="{DynamicResource S.Apps.SystemOff}" />
                </StackPanel>
            </Border>

            <Grid Margin="14,0,14,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="170" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource S.Apps.ColApp}" />
                <TextBlock Grid.Column="1" Style="{StaticResource CardLabel}" Text="{DynamicResource S.Apps.ColKind}" />
                <TextBlock Grid.Column="2" Style="{StaticResource CardLabel}" Text="{DynamicResource S.Apps.ColLink}" />
                <TextBlock Grid.Column="3" Style="{StaticResource CardLabel}" Text="{DynamicResource S.Apps.ColLimit}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Rules}" ItemTemplate="{StaticResource RuleRow}" />

            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,18">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" FontSize="30" Foreground="#8B93A7" HorizontalAlignment="Center" />
                    <TextBlock FontWeight="SemiBold" Margin="0,10,0,2" HorizontalAlignment="Center" Text="{DynamicResource S.Apps.EmptyTitle}" />
                    <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center" Text="{DynamicResource S.Apps.EmptyBody}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="2,10,0,0" TextWrapping="Wrap">
                <Run Text="{Binding KnownGames, Mode=OneWay}" /><Run Text=" " /><Run Text="{DynamicResource S.Apps.KnownGames}" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
