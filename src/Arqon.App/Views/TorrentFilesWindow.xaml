<Window x:Class="Arqon.App.Views.TorrentFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.Dl.Files.Title}" Icon="pack://application:,,,/Resources/arqon.ico" Width="620" Height="520" MinWidth="460" MinHeight="320"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TorrentName" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="Summary" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.Dl.Files.All}" Click="SelectAll" />
                <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{DynamicResource S.Dl.Files.None}" Click="SelectNone" />
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="4">
            <ListBox x:Name="List" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Checked="Changed" Unchecked="Changed"
                                      Foreground="{StaticResource TextBrush}" VerticalContentAlignment="Center">
                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                            </CheckBox>
                            <TextBlock Grid.Column="1" Style="{StaticResource MutedText}" Margin="12,0,0,0" Text="{Binding SizeText}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource GhostButton}" Content="{DynamicResource S.Dl.Files.Cancel}" IsCancel="True" />
            <Button x:Name="Ok" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{DynamicResource S.Dl.Files.Ok}" IsDefault="True" Click="Accept" />
        </StackPanel>
    </Grid>
</Window>
