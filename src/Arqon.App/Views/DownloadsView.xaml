<UserControl x:Class="Arqon.App.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Arqon.App.Controls"
             xmlns:vm="clr-namespace:Arqon.App.ViewModels">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <DataTemplate x:Key="Item" DataType="{x:Type vm:DownloadItemViewModel}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="#8B93A7" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" MaxWidth="460" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}">
                                <Run Text="{Binding SpeedText, Mode=OneWay}" Foreground="#E7EAF2" FontWeight="SemiBold" /><Run Text="   " /><Run Text="{Binding EtaText, Mode=OneWay}" />
                            </TextBlock>
                        </Grid>
                        <c:SplitBar Height="8" Margin="0,10,0,0" Parts="{Binding Parts}" Total="{Binding TotalForBar}" />
                        <Grid Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12">
                                <Run Text="{Binding StateText, Mode=OneWay}" Foreground="#E7EAF2" /><Run Text="  ·  " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource MutedText}" FontSize="12" Text="{Binding Split}" />
                        </Grid>
                        <TextBlock Foreground="#F87171" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" Text="{Binding Error}"
                                   Visibility="{Binding HasError, Converter={StaticResource B2V}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Content="&#xE769;" Command="{Binding PauseCommand}" ToolTip="{DynamicResource S.Dl.Pause}"
                                Visibility="{Binding CanPause, Converter={StaticResource B2V}}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE768;" Command="{Binding StartNowCommand}" ToolTip="{DynamicResource S.Dl.StartNow}"
                                Visibility="{Binding CanStartNow, Converter={StaticResource B2V}}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE768;" Command="{Binding ResumeCommand}" ToolTip="{DynamicResource S.Dl.Resume}"
                                Visibility="{Binding CanResume, Converter={StaticResource B2V}}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8FD;" Command="{Binding ChooseFilesCommand}" ToolTip="{DynamicResource S.Dl.Files}"
                                Visibility="{Binding CanChooseFiles, Converter={StaticResource B2V}}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" Command="{Binding OpenFolderCommand}" ToolTip="{DynamicResource S.Dl.OpenFolder}" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding CancelCommand}" ToolTip="{DynamicResource S.Dl.Remove}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20">
            <Grid>
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource S.Nav.Downloads}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,16" TextWrapping="Wrap" Text="{DynamicResource S.Dl.Sub}" />
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource MutedText}">
                    <Run Text="{Binding TotalSpeed, Mode=OneWay}" Foreground="#E7EAF2" FontWeight="SemiBold" FontSize="16" />
                </TextBlock>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10" BorderBrush="#6C8CFF" Padding="14,10"
                    Visibility="{Binding HasClipboardLink, Converter={StaticResource B2V}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Foreground="#6C8CFF" FontSize="16" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="{DynamicResource S.Dl.ClipTitle}" />
                        <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding ClipboardLink}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Content="{DynamicResource S.Dl.ClipAdd}" Command="{Binding AcceptClipboardCommand}" />
                    <Button Grid.Column="3" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{DynamicResource S.Dl.ClipDismiss}" Command="{Binding DismissClipboardCommand}" />
                </Grid>
            </Border>

            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox Text="{Binding UrlText, UpdateSourceTrigger=PropertyChanged}" Padding="12,10">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock IsHitTestVisible="False" Margin="14,0,0,0" VerticalAlignment="Center"
                               Text="{DynamicResource S.Dl.Placeholder}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UrlText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{DynamicResource S.Dl.Paste}" Command="{Binding PasteCommand}" />
                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{DynamicResource S.Dl.AddTorrent}" Command="{Binding AddTorrentFileCommand}" />
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{DynamicResource S.Dl.Download}" Command="{Binding AddCommand}" />
            </Grid>
            <TextBlock Foreground="#F59E0B" FontSize="12" Margin="2,0,0,6" Text="{Binding Message}" Visibility="{Binding HasMessage, Converter={StaticResource B2V}}" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="{DynamicResource S.Dl.SaveTo}" />
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Text="{Binding FolderText}" Margin="6,0,0,0" Foreground="#E7EAF2" />
                <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="6,0,0,0" Text="{DynamicResource S.Dl.FolderAuto}"
                           Visibility="{Binding FolderIsAuto, Converter={StaticResource B2V}}" />
                <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="11" Content="&#xE70F;" Margin="4,-2,0,0"
                        Command="{Binding ChooseFolderCommand}" ToolTip="{DynamicResource S.Dl.Folder}" />
                <Button Style="{StaticResource IconButton}" Width="22" Height="22" FontSize="11" Content="&#xE777;" Margin="2,-2,0,0"
                        Command="{Binding ResetFolderCommand}" ToolTip="{DynamicResource S.Dl.FolderReset}"
                        Visibility="{Binding FolderIsCustom, Converter={StaticResource B2V}}" />
            </StackPanel>

            <Border Style="{StaticResource Card}" Visibility="{Binding IsEmpty, Converter={StaticResource B2V}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,22">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="30" Foreground="#8B93A7" HorizontalAlignment="Center" />
                    <TextBlock FontWeight="SemiBold" Margin="0,10,0,2" HorizontalAlignment="Center" Text="{DynamicResource S.Dl.EmptyTitle}" />
                    <TextBlock Style="{StaticResource MutedText}" HorizontalAlignment="Center" Text="{DynamicResource S.Dl.EmptyBody}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Item}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
