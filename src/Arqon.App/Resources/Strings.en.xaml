    <sys:String x:Key="S.Dl.BadUrl">That is not a valid http/https link.</sys:String>

    <sys:String x:Key="S.Set.Sub">Tune how Arqon works.</sys:String>
    <sys:String x:Key="S.Set.GameProtection">Game protection</sys:String>
    <sys:String x:Key="S.Set.GameProtectionBody">Game traffic always uses the lowest-ping, steadiest connection, and downloads never get in its way.</sys:String>
    <sys:String x:Key="S.Set.SystemMode">System mode (experimental)</sys:String>
    <sys:String x:Key="S.Set.SystemModeBody">Spreads the connections of Telegram, Chrome and every other app across your networks. Needs the packet driver and administrator rights.</sys:String>
    <sys:String x:Key="S.Set.SystemModeReady">Ready.</sys:String>
    <sys:String x:Key="S.Set.SystemModeWip">Not available yet: the packet driver is not connected. For now the monitor and Arqon's download manager work.</sys:String>
    <sys:String x:Key="S.Set.FixTitle">Windows network policy</sys:String>
    <sys:String x:Key="S.Set.FixNeeded">A fix is recommended.</sys:String>
    <sys:String x:Key="S.Set.FixOk">No problem found.</sys:String>
    <sys:String x:Key="S.Set.Language">Language</sys:String>
    <sys:String x:Key="S.Set.LanguageBody">The interface language changes immediately.</sys:String>
    <sys:String x:Key="S.Set.Startup">Start with Windows</sys:String>
    <sys:String x:Key="S.Set.StartupBody">Arqon starts by itself when the computer turns on.</sys:String>
    <sys:String x:Key="S.Set.Admin">Administrator rights</sys:String>
    <sys:String x:Key="S.Set.AdminYes">Arqon is running as administrator.</sys:String>
    <sys:String x:Key="S.Set.AdminNo">Normal mode. System mode and the Windows fix need administrator rights.</sys:String>
    <sys:String x:Key="S.Set.RestartAdmin">Restart as administrator</sys:String>
