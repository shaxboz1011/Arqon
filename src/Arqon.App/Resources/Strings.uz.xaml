    <sys:String x:Key="S.Setup.Button">Tizim rejimini sozlash</sys:String>
    <sys:String x:Key="S.Setup.Body">Bir bosishda: Arqon kerakli paket drayverini oladi, Windows Defender unga tegmasligini sozlaydi va tizim rejimini yoqadi. Windows administrator huquqini bir marta so'raydi.</sys:String>
    <sys:String x:Key="S.Setup.Working">Sozlanmoqda… {0}%</sys:String>
    <sys:String x:Key="S.Setup.NotStarted">Drayver o'rnatildi, lekin tizim rejimi ishga tushmadi: {0}</sys:String>
    <sys:String x:Key="S.Setup.Confirm">Windows hozir administrator huquqini so'raydi, Arqon qayta ishga tushadi va:

• Windows Defender'ga {0} papkasiga tegmaslikni aytadi (Defender WinDivert paket drayverini xato ravishda shubhali deb belgilab o'chiradi);
• rasmiy WinDivert 2.2.2 drayverini yuklaydi, aynan asl fayl ekanini va imzosi to'g'ri ekanini tekshiradi;
• tizim rejimini yoqadi.

Kompyuterdagi boshqa hech narsa o'zgarmaydi. Davom etamizmi?</sys:String>

    <sys:String x:Key="S.Diag.Title">Muammo hisoboti</sys:String>
    <sys:String x:Key="S.Diag.Body">Xatoni tuzatishga yordam beradigan narsalarni nusxalaydi: versiya, Windows, ulanishlar, tizim rejimi va oxirgi xatolar. Foydalanuvchi nomingiz, to'liq manzillar va papkalar kirmaydi. Uni GitHub issue'ga qo'ying.</sys:String>
    <sys:String x:Key="S.Diag.Copy">Hisobotni nusxalash</sys:String>
    <sys:String x:Key="S.Diag.Folder">Loglar papkasini ochish</sys:String>
    <sys:String x:Key="S.Diag.Copied">Hisobot nusxalandi.</sys:String>
    <sys:String x:Key="S.Diag.Busy">Bufer band. Qayta urinib ko'ring.</sys:String>
    <sys:String x:Key="S.Diag.NoCrash">Hech qanday xato qayd etilmagan.</sys:String>
    <sys:String x:Key="S.Diag.LastCrash">Oxirgi xato: {0}</sys:String>
    <sys:String x:Key="S.Diag.CrashHint">Sozlamalar → Muammo hisoboti xato haqida batafsil ma'lumotni nusxalaydi.</sys:String>

    <sys:String x:Key="S.Set.Upnp">Routerda torrent portini ochish (UPnP)</sys:String>
    <sys:String x:Key="S.Set.UpnpBody">Routerdan boshqa peerlarga sizga ulanishga ruxsat berishni so'raydi, bu kam tarqalgan torrentlar va tarqatish uchun foydali. Router sozlamasini o'zgartiradi, shuning uchun standart holatda o'chiq.</sys:String>
    <sys:String x:Key="S.Set.Saver">Shu ulanishlarda trafikni tejash</sys:String>
    <sys:String x:Key="S.Set.SaverBody">Belgilangan ulanishni yuklashlar va torrentlar boshqa ulanish bor paytda ishlatmaydi, faqat u yolg'iz qolganda ishlatadi. Kichik tarifli telefon uchun qulay.</sys:String>
    <sys:String x:Key="S.Set.SaverNone">Hozir ulanish yo'q.</sys:String>
    <sys:String x:Key="S.Set.SaveMobile">Kunlik chegaraga yetganda yuklashlarni telefondan olib qo'yish</sys:String>
    <sys:String x:Key="S.Set.SaveMobileBody">Bugungi trafik yuqoridagi kunlik chegaraga yetganda, telefon ulanishlari ertagacha "tejash" deb hisoblanadi.</sys:String>
    <sys:String x:Key="S.Set.Schedule">Yuklash jadvali</sys:String>
    <sys:String x:Key="S.Set.ScheduleBody">Navbatdagi yuklashlar faqat shu soatlarda boshlanadi (masalan arzonroq tungi tarif). Boshlangan yuklashlar davom etadi, "Hozir boshlash" esa doim ishlaydi.</sys:String>
    <sys:String x:Key="S.Set.ScheduleFrom">Boshlanishi</sys:String>
    <sys:String x:Key="S.Set.ScheduleTo">tugashi</sys:String>
    <sys:String x:Key="S.Dl.Scheduled">Navbatdagi yuklashlar jadvalni kutmoqda, {0} da boshlanadi.</sys:String>

    <sys:String x:Key="S.Api.Title">Skriptlar uchun mahalliy API</sys:String>
    <sys:String x:Key="S.Api.Body">Shu kompyuterdagi skriptlar va dasturlarga ulanishlar va yuklashlarni o'qish hamda yuklash qo'shish imkonini beradi. Unga faqat shu kompyuterdan ulanish mumkin, har bir so'rovga token kerak. Standart holatda o'chiq.</sys:String>
    <sys:String x:Key="S.Api.Address">{0} manzilida tinglayapti. Authorization: Bearer &lt;token&gt; sarlavhasini yuboring. Batafsil: docs/api.md.</sys:String>
