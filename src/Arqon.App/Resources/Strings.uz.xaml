    <sys:String x:Key="S.Set.ShellOther">Magnet linklarni hozir "{0}" ochadi. Arqon ro'yxatga olindi, uni standart qilish uchun pastdagi tugma orqali Windows'da "magnet" uchun Arqon'ni tanlang.</sys:String>
