    <sys:String x:Key="S.Dl.Sub">Link yoki magnet bering: fayl bo'laklarga bo'linib, barcha ulanishlardan bir vaqtda yuklanadi. .torrent fayl ham bo'ladi.</sys:String>
    <sys:String x:Key="S.Dl.Placeholder">https://misol.uz/fayl.zip yoki magnet:?xt=…</sys:String>
    <sys:String x:Key="S.Dl.AddTorrent">Torrent fayl</sys:String>
    <sys:String x:Key="S.Set.Shell">Torrent va magnet linklarni Arqon bilan ochish</sys:String>
    <sys:String x:Key="S.Set.ShellBody">Brauzerdagi magnet linklar va .torrent fayllar Arqon'da ochiladi, yuklash o'zi boshlanadi. Windows 10 standart ilovani o'zingiz tasdiqlashingizni so'rashi mumkin (pastdagi tugma).</sys:String>
